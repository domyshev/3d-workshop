// Serviceable dashboard/shelf, full-height socket webs and no chine flange.
use <releases/2026-10-23_bow-plan-proportions/source.scad>
part="layout"; // [lower, upper, dashboard, retainer, assembly, layout]
remove_flange=true;
sf=170/4600;
shelf_z=550*sf;
face_x=1600*sf;
wall_x=1400*sf;
roof_under=750*sf+2.4-1.2;
module old_lower() {
    import("releases/2026-10-28_partition-joint/2026-10-28_sarepta_170mm_partition_joint_lower.stl",convexity=30);
}
module old_upper() {
    import("releases/2026-10-28_partition-joint/2026-10-27_sarepta_170mm_horizontal_upper.stl",convexity=30);
}
module socket_reinforcement() {
    intersection() {
        body_blank();
        for(s=[-1,1]) hull() {
            translate([33,s*17,20]) cylinder(d=7.2,h=5,$fn=64);
            translate([33,s*25.4,12]) cylinder(d=2,h=13,$fn=24);
        }
    }
}
