module dashboard_clearance() {
    translate([wall_x+0.01,-20.65,shelf_z-0.05])
        cube([face_x+0.15-wall_x-0.01,41.3,15]);
}
module guides() {
    for(s=[-1,1]) {
        // Open-ended sliding seats, tied to the fixed nose wall and side plating.
        translate([wall_x-0.25,s==1?19.2:-26,shelf_z-1.4])
            cube([face_x+0.3-wall_x+0.25,6.8,1.4]);
        translate([wall_x-0.25,s==1?20.65:-22.25,shelf_z])
            cube([face_x+0.3-wall_x+0.25,1.6,1.5]);
        // Retainer sockets stay below the shelf so they cannot block extraction.
        translate([face_x-0.2,s==1?18:-26,shelf_z-3]) cube([3.8,8,3]);
    }
}
module retainer_bores() {
    for(y=[-19.2,19.2]) translate([60.5,y,shelf_z-2.6])
        cylinder(d=2.3,h=3,$fn=40);
}
module lower() {
    difference() {
        union() {
            difference() {old_lower();dashboard_clearance();if(remove_flange) flange_only();}
            socket_reinforcement();
            guides();
        }
        for(y=[-17,17]) translate([33,y,20.8]) cylinder(d=4.25,h=10,$fn=64);
        retainer_bores();
    }
}
module upper() {
    difference() {
        old_upper();
        // Preserve 1.2 mm foredeck skin; clear the whole removable face below it.
        translate([face_x-1.45,-20.65,24.9])
            cube([1.6,41.3,roof_under-24.9]);
    }
}
module dashboard() {
    difference() {
        union() {
            translate([wall_x+0.25,-20.4,shelf_z])
                cube([face_x-wall_x-0.25,40.8,1.2]);
            translate([face_x-1.2,-20.4,shelf_z])
                cube([1.2,40.8,roof_under-0.2-shelf_z]);
        }
        storage_pocket_cuts();
    }
}
module retainer() {
    union() {
        translate([face_x+0.25,-20.4,shelf_z]) cube([61.62-face_x-0.25,40.8,1.6]);
        for(y=[-19.2,19.2]) translate([60.5,y,shelf_z-2.4])
            cylinder(d=2,h=2.45,$fn=40);
    }
}
$vpr=[65,0,35];$vpt=[85,35,12];$vpd=650;
color([0.67,0.67,0.67]) {
    if(part=="lower") lower();
    else if(part=="upper") upper();
    else if(part=="dashboard") dashboard();
    else if(part=="retainer") retainer();
    else if(part=="assembly") {lower();upper();dashboard();retainer();}
    else if(part=="layout") {
        lower();
        translate([0,85,55]) rotate([180,0,0]) upper();
        translate([35,-65,-shelf_z]) dashboard();
        translate([35,-85,-shelf_z+2.4]) retainer();
    }
}
